{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 80,
  "sortImports": true,
  "sortPackageJson": false,
  "sortTailwindcss": true,
  "ignorePatterns": [
    "pnpm-lock.yaml",
    "dist/",
    "node_modules/",
    "*.log",
    "runs/",
    "reports/"
  ]
}
