{
  "name": "durably-factory",
  "private": true,
  "type": "module",
  "scripts": {
    "pricing:check": "tsx scripts/update-pricing.ts",
    "factory": "tsx src/cli.ts",
    "worker": "tsx src/cli.ts worker",
    "build:ui": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "test": "pnpm test:unit",
    "test:unit": "tsx --test tests/*.test.ts",
    "validate": "pnpm format && pnpm lint && pnpm typecheck && pnpm test && pnpm build:ui",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@coji/durably": "^0.16.1",
    "ai": "^7.0.166",
    "ai-sdk-provider-claude-code": "^4.4.1",
    "ai-sdk-provider-codex-cli": "^2.4.0",
    "better-sqlite3": "13.0.3",
    "kysely": "^0.29.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.2.1",
    "lefthook": "2.2.2",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.6"
  },
  "description": "A local agent factory on Durably: implement, verify against a pinned check, review independently, and wait for approval.",
  "license": "MIT",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.22.2 <25",
    "pnpm": "12.18.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.2",
      "onFail": "download"
    }
  }
}
